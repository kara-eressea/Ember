# Copy to .env and adjust. Never commit real secrets.

# Postgres (docker-compose.dev.yml defaults)
DATABASE_URL=postgres://emberchat:emberchat@localhost:5432/emberchat

# Storage driver. Leave unset: a server always wants node-postgres, and the
# only other value (pglite, the desktop client's embedded database) needs a
# package the server image deliberately does not ship.
# DB_DRIVER=node-postgres

# Secret for signing access tokens — at least 32 characters. The server
# refuses to start with this placeholder value.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=dev-only-secret-change-me-0000000000

HOST=127.0.0.1
PORT=3000

# REQUIRED when running behind a reverse proxy (nginx/traefik), or per-IP
# rate limits key on the proxy address — one shared bucket for every client.
# Accepts true/false, a hop count, or comma-separated addresses/CIDRs.
# TRUST_PROXY=1

# F-Chat endpoints. Development runs against fchat-sim (start it with
# `pnpm --filter @emberchat/fchat-sim start`); heavy testing against the
# live server is discouraged (design/testing-strategy.md). Uncomment the
# real endpoints only for short, supervised verification passes.
FCHAT_URL=ws://127.0.0.1:9090/chat2
FLIST_API_URL=http://127.0.0.1:9090
# FCHAT_URL=wss://chat.f-list.net/chat2
# FLIST_API_URL=https://www.f-list.net
# F-List JSON API pacing. 1000 (1 req/s) is the developer-policy budget —
# only lower it when FLIST_API_URL points at a local fchat-sim.
# FLIST_API_MIN_INTERVAL_MS=1000
# Reconnect backoff. The 10s floor is developer policy — these knobs exist for
# fchat-sim stacks only, and a shorter floor refuses to boot against F-Chat.
# FCHAT_RECONNECT_FLOOR_MS=10000
# FCHAT_RECONNECT_CAP_MS=300000

APP_BASE_URL=http://localhost:3000

# The product name is a build-time constant (decisions.md §5), and so is the
# IDN cname half of it. Only the cversion is config — the release build sets
# it; locally it stays 0.0.0.
CLIENT_VERSION=0.0.0

# Comma-separated allowed browser origins (the Vite dev server in development).
CORS_ORIGIN=http://localhost:5173

# Self-service signup is off by default — instances are admin-only
# (design/decisions.md §2). Create accounts and reset passwords with the
# admin CLI instead: node dist/cli/admin.js --help
# REGISTRATION_ENABLED=false

# Web push (design/web-push.md). All three together, or none at all — unset
# means the feature is invisible end-to-end. Browsers only allow push on a
# secure origin, so a plain http:// dev server cannot exercise it; localhost
# counts as secure, which is what makes local testing possible.
# Generate: npx web-push generate-vapid-keys
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=
# PUSH_VAPID_SUBJECT=mailto:dev@example.test

# Daily update check against the GitHub Releases API — shows a quiet
# "update available" hint in the UI. It reveals the instance's existence
# to GitHub, nothing more; set false to disable the phone-home.
# UPDATE_CHECK_ENABLED=true
# UPDATE_CHECK_REPO=kara-eressea/Ember

# One-boot acknowledgment when an upgrade crosses a migration flagged
# BREAKING (drizzle/breaking.json) — the server refuses to start otherwise.
# Back up first (pg_dump), read the release notes, set true for one boot,
# then remove it.
# CONFIRM_BREAKING_UPGRADE=false
