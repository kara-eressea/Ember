# docker-compose deployment config — copy to .env and set real values.
# (apps/server/.env.example is the separate host-development config.)
# Never commit real secrets. Full walkthrough: docs/self-hosting.md

# ── Required ─────────────────────────────────────────────────────────────────

# Postgres superuser password for the bundled postgres service.
POSTGRES_PASSWORD=change-me

# Secret for signing access tokens — at least 32 characters. The server
# refuses to start with the placeholder from apps/server/.env.example.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# OPTIONAL: enables "Remember on this server" — F-List passwords stored
# encrypted (AES-256-GCM) so server restarts reconnect automatically.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Leave unset to keep the memory-only model (a restart asks for passwords).
# The key lives only in this file: database dumps/backups alone stay
# ciphertext. This protects backups, NOT a fully compromised machine.
#CREDENTIALS_KEY=

# ── Image & listening ────────────────────────────────────────────────────────

# Which ghcr tag to run: vX.Y.Z (exact) | vX.Y (compatible) | latest | edge.
#IMAGE_TAG=latest

# Where the server listens on the host: PORT is the host-side published
# port (the container always listens on 3000 internally — compose maps
# PORT:3000). Default binds loopback only — put a TLS-terminating reverse
# proxy in front and set TRUST_PROXY. Browsing to a non-default port
# directly (no proxy)? APP_BASE_URL must include the port, or the
# gateway's origin check closes the socket with code 4403.
#BIND_ADDRESS=127.0.0.1
#PORT=3000
#TRUST_PROXY=1

# ── Rate limits ──────────────────────────────────────────────────────────────

# Per-IP request backstop, requests/minute. Generous for a single-tenant
# instance; raise it only if a legitimate client trips it. Behind a proxy
# these key on the proxy's address unless TRUST_PROXY is set above — one
# shared bucket for every client, which is the usual cause of a mystery 429.
#RATE_LIMIT_MAX=300

# The same, for the auth endpoints alone (login, token refresh). The knob to
# reach for when a real person is locked out rather than a bot slowed down.
#AUTH_RATE_LIMIT_MAX=10

# ── F-Chat ───────────────────────────────────────────────────────────────────

# Defaults are the real service; for the smoke profile:
#FCHAT_URL=ws://sim:9090/chat2
#FLIST_API_URL=http://sim:9090

# ── Public origin ────────────────────────────────────────────────────────────

# Your instance's public origin (feeds the WebSocket origin allow-list).
#APP_BASE_URL=https://your-domain.example

# The product name is not configurable: "EmberChat" is a build-time constant
# (decisions.md §5), and it is also the IDN cname the F-List developer policy
# wants honest and unique. The cversion half is baked into the image by the
# release workflow.

# ── Retention & logs ─────────────────────────────────────────────────────────

# Message retention: forever (default) | 30d | 90d | 1y. Age policies
# delete history older than the cutoff on each sweep. Your logs' location:
# the messages table in the Postgres volume (F-List developer policy: logs
# must be known and accessible to the user).
#RETENTION_POLICY=forever

# How often the sweep runs (ms, 6 h default). A no-op under "forever"; lower
# it only if an age policy has to bite closer to its cutoff than half a day.
#RETENTION_SWEEP_INTERVAL_MS=21600000

# Disconnect a character from F-Chat after this many hours with no device
# attached (0 = stay connected forever). Courtesy toward F-List — a bouncer
# nobody reads shouldn't hold a connection for weeks. Reopening the app
# reconnects automatically (credentials stay in the server's memory).
#DETACHED_DISCONNECT_HOURS=72

# ── Profiles (M8) ────────────────────────────────────────────────────────────

# Character-data requests allowed per sliding hour (profile views, guestbook
# pages). F-List allows 200/hour; the 170 default leaves headroom — do NOT
# raise this above the currently published limit. When exhausted, cached
# profiles are served stale until the window frees up.
#CHARACTER_DATA_BUDGET_PER_HOUR=170

# How long a cached profile stays fresh before a view refetches it (ms).
#PROFILE_CACHE_TTL_MS=86400000

# Bulk mapping-list (infotags/kinks/listitems) refresh window (ms). These
# are ticketless, cheap, and drift rarely — a week is plenty.
#FLIST_MAPPINGS_TTL_MS=604800000

# Eicon search index host (M8). Only contacted when a user enables the
# eiconSearchEnabled preference: the server downloads the bulk index and
# searches it locally — user queries never leave the server.
#EICON_INDEX_BASE_URL=https://xariah.net

# How often the eicon index delta-refreshes (ms, ~daily upstream).
#EICON_INDEX_REFRESH_MS=86400000

# ── Web push notifications ───────────────────────────────────────────────────

# OPTIONAL: OS notifications on phones and desktops while no tab is open —
# the point of running a bouncer. Set all three or none; unset means the
# feature does not exist on this instance (no UI, nothing sent).
#
# Generate the keypair once and keep it: node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
# (or: npx web-push generate-vapid-keys)
#
# Requires HTTPS — browsers refuse push on insecure origins. iOS additionally
# needs the app installed to the home screen. See docs/self-hosting.md.
#PUSH_VAPID_PUBLIC_KEY=
#PUSH_VAPID_PRIVATE_KEY=

# Contact address the push services use if a subscription misbehaves.
# A mailto: address or an https:// URL.
#PUSH_VAPID_SUBJECT=mailto:you@your-domain.example

# ── Updates & upgrades ───────────────────────────────────────────────────────

# Daily update check against the GitHub Releases API (a quiet "update
# available" hint in the UI). Reveals the instance's existence to GitHub,
# nothing more; set false to disable the phone-home. When it finds a newer
# release the version beside the app name tints and links to it — no banners.
#UPDATE_CHECK_ENABLED=true

# The repo those releases are read from — point it at your own fork if you
# run one, so the hint tracks the code you actually deploy.
#UPDATE_CHECK_REPO=kara-eressea/Ember

# One-boot acknowledgment when an upgrade crosses a migration flagged
# BREAKING — the server refuses to start otherwise. Back up first, read the
# release notes, set true for one boot, then remove it.
#CONFIRM_BREAKING_UPGRADE=false

# ── Backups ──────────────────────────────────────────────────────────────────

# The backup service pg_dumps into BACKUP_DIR on this schedule and prunes
# dumps older than BACKUP_KEEP_DAYS. Restore drill: docs/self-hosting.md.
#BACKUP_DIR=./backups
#BACKUP_INTERVAL_SECONDS=86400
#BACKUP_KEEP_DAYS=14
