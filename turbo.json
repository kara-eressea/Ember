{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "e2e": {
      // "build" (the web app's own) as well as its dependencies': the caret
      // specs run against `vite preview`, i.e. the built bundle.
      "dependsOn": ["build", "^build", "@emberchat/server#build"],
      "cache": false
    }
  }
}
